{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user identity record stored per Firebase Auth user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display nickname shown in karaoke rooms and chat",
          "minLength": 1,
          "maxLength": 48
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile avatar URL",
          "maxLength": 512
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider identifier",
          "enum": ["google.com", "password", "phone", "other"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "displayName", "authProvider", "createdAt", "updatedAt"]
    },
    "PrivateAccountInfo": {
      "title": "PrivateAccountInfo",
      "description": "Isolated PII document containing email or phone contact strictly owned by the user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User account email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile settings owned exclusively by the authenticated user."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateAccountInfo" },
      "description": "Private PII subcollection isolated strictly to the owner."
    }
  }
}
